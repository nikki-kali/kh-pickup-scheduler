# Postgres connection string for KH's own database
DATABASE_URL=

# Public URL this backend is deployed at (used to build the one-click
# Dispatch/Received links embedded in the staff notification email)
BACKEND_URL=https://kh-crm-backend.onrender.com

# KH's marketing site origin, for CORS on non-public routes
FRONTEND_URL=https://khdentallab.com

# HMAC secret signing the one-click dispatch/received email links —
# generate a fresh random value, don't reuse AIM's.
PICKUP_ACTION_SECRET=

# Where pickup / contact form notifications are sent internally
PICKUP_FORM_EMAIL=digital@khdentallab.com
PICKUP_FORM_CC=                       # comma-separated, optional, e.g. shipping@khdentallab.com,ben@khdentallab.com
CONTACT_FORM_EMAIL=info@khdentallab.com

# Fallback recipient if PICKUP_FORM_EMAIL/CONTACT_FORM_EMAIL aren't set
ALERT_EMAIL=

# Resend (primary email sender)
RESEND_API_KEY=
RESEND_FROM=KH Dental Lab <onboarding@resend.dev>

# Brevo (optional fallback — only needed if Resend delivery is unreliable)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

PORT=4000
